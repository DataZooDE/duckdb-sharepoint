# name: test/sql/sharepoint_excel.live.template
# description: read_excel_table / read_excel_range against a REAL workbook
#              through the Microsoft Graph workbook API. Materialised and run by
#              scripts/run_live_tests.sh (`make test_live`), like
#              sharepoint.live.template. The workbook is
#              test/data/excel/fixture.xlsx (scripts/make_excel_fixture.py).
# group: [sharepoint]

require sharepoint

require-env SHAREPOINT_TENANT_ID

# As in sharepoint.live.template: no Graph failure may be skipped as "HTTP".
set ignore_error_messages __sharepoint_never_ignore__

statement ok
CREATE OR REPLACE SECRET sp_live (
    TYPE sharepoint,
    PROVIDER client_credentials,
    TENANT_ID '@SHAREPOINT_TENANT_ID@',
    CLIENT_ID '@SHAREPOINT_CLIENT_ID@',
    CLIENT_SECRET '@SHAREPOINT_CLIENT_SECRET@',
    DRIVE_ID '@SHAREPOINT_DRIVE_ID@'
);

# One folder per run: Excel for the web keeps a workbook it has opened busy
# for a while, so a fixed path could make the next run's upload fail.
statement ok
SELECT write_blob('sharepoint://_duckdb_sharepoint_live/excel/run-@RUN_ID@/fixture.xlsx',
                  (SELECT content FROM read_blob('test/data/excel/fixture.xlsx')));

# ---------------------------------------------------------------------------
# 1. A named table: header row -> column names, one type per column inferred
#    from the values and number formats.
# ---------------------------------------------------------------------------
query II
SELECT column_name, column_type
FROM (DESCRIBE SELECT * FROM read_excel_table('sharepoint://_duckdb_sharepoint_live/excel/run-@RUN_ID@/fixture.xlsx', 'Sales'));
----
Region	VARCHAR
Month	DATE
Revenue	DOUBLE
Units	BIGINT
Active	BOOLEAN
Note	VARCHAR
Updated	TIMESTAMP
Start	TIME
Ratio	DOUBLE

# Empty cells and the #DIV/0! of =1/0 read as NULL.
query IIIIIIIII
SELECT * FROM read_excel_table('sharepoint://_duckdb_sharepoint_live/excel/run-@RUN_ID@/fixture.xlsx', 'Sales');
----
North	2025-01-01	1200.5	10	true	ok	2025-01-01 08:30:00	09:00:00	0.5
South	2025-02-01	980.25	7	false	NULL	2025-02-01 17:45:00	13:30:00	2.0
East	2025-03-01	NULL	12	true	late	2025-03-01 00:00:00	07:15:00	NULL

# The scheme is optional; the secret's drive is implied.
query I
SELECT count(*) FROM read_excel_table('_duckdb_sharepoint_live/excel/run-@RUN_ID@/fixture.xlsx', 'Sales');
----
3

# all_varchar: untyped text; dates as ISO text, not serial numbers.
query III
SELECT Month, Units, Active FROM read_excel_table('_duckdb_sharepoint_live/excel/run-@RUN_ID@/fixture.xlsx', 'Sales', all_varchar := true) LIMIT 1;
----
2025-01-01	10	TRUE

# Cost: one stat, then header, body address and ONE block of values.
statement ok
CALL sharepoint_reset_stats();

statement ok
SELECT * FROM read_excel_table('_duckdb_sharepoint_live/excel/run-@RUN_ID@/fixture.xlsx', 'Sales');

query II
SELECT (SELECT value FROM sharepoint_stats() WHERE metric = 'stat'),
       (SELECT value FROM sharepoint_stats() WHERE metric = 'workbook');
----
1	3

# ---------------------------------------------------------------------------
# 2. A range: an explicit address, a bare sheet (its used range), no header,
#    and a sheet name that needs quoting.
# ---------------------------------------------------------------------------
query III
SELECT * FROM read_excel_range('_duckdb_sharepoint_live/excel/run-@RUN_ID@/fixture.xlsx', 'Input!B3:D6');
----
widget	3	2.5
gadget	4	10.0
doohickey	NULL	1.25

query II
SELECT column_name, column_type
FROM (DESCRIBE SELECT * FROM read_excel_range('_duckdb_sharepoint_live/excel/run-@RUN_ID@/fixture.xlsx', 'Input!B3:D6'));
----
product	VARCHAR
qty	BIGINT
price	DOUBLE

query III
SELECT * FROM read_excel_range('_duckdb_sharepoint_live/excel/run-@RUN_ID@/fixture.xlsx', 'Input!B4:D5', header := false);
----
widget	3	2.5
gadget	4	10.0

query I
SELECT string_agg(column_name, ',')
FROM (DESCRIBE SELECT * FROM read_excel_range('_duckdb_sharepoint_live/excel/run-@RUN_ID@/fixture.xlsx', 'Input!B4:D5', header := false));
----
column1,column2,column3

# A bare sheet name reads its used range, A1:D6 here (the title in A1).
query I
SELECT count(*) FROM read_excel_range('_duckdb_sharepoint_live/excel/run-@RUN_ID@/fixture.xlsx', 'Input', header := false);
----
6

query I
SELECT x FROM read_excel_range('_duckdb_sharepoint_live/excel/run-@RUN_ID@/fixture.xlsx', '''My Sheet''!A1:A2');
----
1

# ---------------------------------------------------------------------------
# 3. Errors name what is missing.
# ---------------------------------------------------------------------------
statement error
SELECT * FROM read_excel_table('_duckdb_sharepoint_live/excel/run-@RUN_ID@/fixture.xlsx', 'Nope');
----
table 'Nope'

statement error
SELECT * FROM read_excel_range('_duckdb_sharepoint_live/excel/run-@RUN_ID@/fixture.xlsx', 'Nope!A1:B2');
----
worksheet 'Nope'

statement error
SELECT * FROM read_excel_range('_duckdb_sharepoint_live/excel/run-@RUN_ID@/fixture.xlsx', 'A1:B2');
----
names no worksheet

statement error
SELECT * FROM read_excel_table('_duckdb_sharepoint_live/excel/run-@RUN_ID@/missing.xlsx', 'Sales');
----
not found

# ---------------------------------------------------------------------------
# 4. Write back: COPY ... (FORMAT excel_range) into a new sheet, typed.
#    Text stays text ('=1+1' is no formula, '00123' no number).
# ---------------------------------------------------------------------------
statement ok
CALL sharepoint_reset_stats();

statement ok
COPY (SELECT * FROM (VALUES
        ('a', 1, 2.5, DATE '2026-01-31', TIMESTAMP '2026-01-31 13:45:00', TIME '07:30:00', true, '=1+1'),
        ('b', 2, NULL, DATE '2026-02-28', TIMESTAMP '2026-02-28 00:00:00', TIME '23:59:59', false, '00123'))
      t(name, n, x, d, ts, tm, flag, raw))
TO '_duckdb_sharepoint_live/excel/run-@RUN_ID@/fixture.xlsx' (FORMAT excel_range, RANGE 'Out!B2');

# One stat; session, sheet lookup, sheet add, one PATCH, close, and one
# check that the new sheet is visible outside the session.
query II
SELECT (SELECT value FROM sharepoint_stats() WHERE metric = 'stat'),
       (SELECT value FROM sharepoint_stats() WHERE metric = 'workbook');
----
1	6

query II
SELECT column_name, column_type
FROM (DESCRIBE SELECT * FROM read_excel_range('_duckdb_sharepoint_live/excel/run-@RUN_ID@/fixture.xlsx', 'Out!B2:I4'));
----
name	VARCHAR
n	BIGINT
x	DOUBLE
d	DATE
ts	TIMESTAMP
tm	TIME
flag	BOOLEAN
raw	VARCHAR

query IIIIIIII
SELECT * FROM read_excel_range('_duckdb_sharepoint_live/excel/run-@RUN_ID@/fixture.xlsx', 'Out!B2:I4');
----
a	1	2.5	2026-01-31	2026-01-31 13:45:00	07:30:00	true	=1+1
b	2	NULL	2026-02-28	2026-02-28 00:00:00	23:59:59	false	00123

# Re-running overwrites the same cells; HEADER false writes data only.
statement ok
COPY (SELECT 'c' AS name, 3 AS n) TO '_duckdb_sharepoint_live/excel/run-@RUN_ID@/fixture.xlsx' (FORMAT excel_range, RANGE 'Out!B3', HEADER false);

query II
SELECT name, n FROM read_excel_range('_duckdb_sharepoint_live/excel/run-@RUN_ID@/fixture.xlsx', 'Out!B2:C4');
----
c	3
b	2

# ---------------------------------------------------------------------------
# 5. COPY ... (FORMAT excel_table): append to an existing table, by column
#    name (any order, any case; columns not given stay empty), keeping types.
# ---------------------------------------------------------------------------
statement ok
COPY (SELECT 4 AS units, 'West' AS region, DATE '2025-04-01' AS month, TIMESTAMP '2025-04-01 09:15:00' AS updated)
TO '_duckdb_sharepoint_live/excel/run-@RUN_ID@/fixture.xlsx' (FORMAT excel_table, TABLE 'Sales');

query I
SELECT count(*) FROM read_excel_table('_duckdb_sharepoint_live/excel/run-@RUN_ID@/fixture.xlsx', 'Sales');
----
4

query IIIII
SELECT Region, Month, Units, Updated, Note FROM read_excel_table('_duckdb_sharepoint_live/excel/run-@RUN_ID@/fixture.xlsx', 'Sales') WHERE Region = 'West';
----
West	2025-04-01	4	2025-04-01 09:15:00	NULL

query II
SELECT column_name, column_type
FROM (DESCRIBE SELECT * FROM read_excel_table('_duckdb_sharepoint_live/excel/run-@RUN_ID@/fixture.xlsx', 'Sales')) WHERE column_name IN ('Month', 'Updated');
----
Month	DATE
Updated	TIMESTAMP

# A table that does not exist is created, on a new sheet of its name.
statement ok
COPY (SELECT (DATE '2026-01-01' + INTERVAL (i) MONTH)::DATE AS month, 100.5 + i AS forecast FROM range(12) t(i))
TO '_duckdb_sharepoint_live/excel/run-@RUN_ID@/fixture.xlsx' (FORMAT excel_table, TABLE 'Forecast');

query III
SELECT count(*), min(month), max(forecast) FROM read_excel_table('_duckdb_sharepoint_live/excel/run-@RUN_ID@/fixture.xlsx', 'Forecast');
----
12	2026-01-01	111.5

# ... and a second COPY appends to it.
statement ok
COPY (SELECT DATE '2027-01-01' AS month, 200.5 AS forecast) TO '_duckdb_sharepoint_live/excel/run-@RUN_ID@/fixture.xlsx' (FORMAT excel_table, TABLE 'Forecast');

query I
SELECT count(*) FROM read_excel_table('_duckdb_sharepoint_live/excel/run-@RUN_ID@/fixture.xlsx', 'Forecast');
----
13

# OVERWRITE replaces the table's rows, so re-running a forecast does not
# append: same name, same top-left cell, the old rows gone.
statement ok
COPY (SELECT DATE '2028-01-01' AS month, 1.5 AS forecast UNION ALL SELECT DATE '2028-02-01', 2.5)
TO '_duckdb_sharepoint_live/excel/run-@RUN_ID@/fixture.xlsx' (FORMAT excel_table, TABLE 'Forecast', OVERWRITE);

query III
SELECT count(*), min(month), max(forecast) FROM read_excel_table('_duckdb_sharepoint_live/excel/run-@RUN_ID@/fixture.xlsx', 'Forecast');
----
2	2028-01-01	2.5

# The sheet holds the new table and nothing of the old 13 rows.
query I
SELECT count(*) FROM read_excel_range('_duckdb_sharepoint_live/excel/run-@RUN_ID@/fixture.xlsx', 'Forecast', header := false);
----
3

# excel_range with OVERWRITE clears from the anchor down and right first,
# so a shorter rewrite leaves no stale rows below it.
statement ok
COPY (SELECT i AS n FROM range(5) t(i)) TO '_duckdb_sharepoint_live/excel/run-@RUN_ID@/fixture.xlsx' (FORMAT excel_range, RANGE 'Short!A1');

statement ok
CALL sharepoint_reset_stats();

statement ok
COPY (SELECT 9 AS n) TO '_duckdb_sharepoint_live/excel/run-@RUN_ID@/fixture.xlsx' (FORMAT excel_range, RANGE 'Short!A1', OVERWRITE);

# Session, sheet lookup, used range, clear, one PATCH, close.
query I
SELECT value FROM sharepoint_stats() WHERE metric = 'workbook';
----
6

# The raw cells: header, the new row, then four cleared ones.
query I
SELECT coalesce(column1, '<empty>') FROM read_excel_range('_duckdb_sharepoint_live/excel/run-@RUN_ID@/fixture.xlsx', 'Short!A1:A6', header := false, all_varchar := true);
----
n
9
<empty>
<empty>
<empty>
<empty>

query I
SELECT n FROM read_excel_range('_duckdb_sharepoint_live/excel/run-@RUN_ID@/fixture.xlsx', 'Short');
----
9

statement error
COPY (SELECT 1 AS nope) TO '_duckdb_sharepoint_live/excel/run-@RUN_ID@/fixture.xlsx' (FORMAT excel_table, TABLE 'Sales');
----
has no column "nope"

# A missing table is never created on top of existing data.
statement error
COPY (SELECT 1 AS a) TO '_duckdb_sharepoint_live/excel/run-@RUN_ID@/fixture.xlsx' (FORMAT excel_table, TABLE 'NewOne', SHEET 'Input');
----
already holds data

statement error
COPY (SELECT 1 AS a, 2 AS b) TO '_duckdb_sharepoint_live/excel/run-@RUN_ID@/fixture.xlsx' (FORMAT excel_range, RANGE 'Out!XFD1');
----
past Excel's last column

# No cleanup: Excel for the web keeps a workbook it has opened locked for a
# while (HTTP 423 on delete). The nightly sweep (e2e/helpers/sweep.py,
# LIVE_EXCEL_ROOT) removes run folders older than 24 h.
