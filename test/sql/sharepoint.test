# name: test/sql/sharepoint.test
# description: sharepoint extension loads and registers its surface
# group: [sharepoint]

require sharepoint

# The extension's own version scalar is present.
query I
SELECT sharepoint_version() IS NOT NULL;
----
true

# The scheme-generic mutation functions registered.
statement ok
SELECT function_name FROM duckdb_functions()
WHERE function_name IN ('write_blob', 'remove_file', 'move_file', 'file_size');

# The `sharepoint` secret type exists (creating one needs no network).
statement ok
CREATE SECRET sp_test (
    TYPE sharepoint,
    PROVIDER client_credentials,
    TENANT_ID '00000000-0000-0000-0000-000000000000',
    CLIENT_ID '11111111-1111-1111-1111-111111111111',
    CLIENT_SECRET 'not-a-real-secret',
    DRIVE_ID 'b!placeholder'
);

# The client secret must never be displayed.
query I
SELECT secret_string NOT LIKE '%not-a-real-secret%' FROM duckdb_secrets() WHERE name = 'sp_test';
----
true

statement ok
DROP SECRET sp_test;

# ---------------------------------------------------------------------------
# Live round trip. Skipped unless SHAREPOINT_TENANT_ID et al. are set; the
# materialised copy under test/sql/live/ (generated with real values) is what
# `make test_live` runs. This top-level file only proves load + registration.
# ---------------------------------------------------------------------------
require-env SHAREPOINT_TENANT_ID

# (Live assertions are materialised into test/sql/live/ from a template at run
# time so no credential is ever committed. See docs/hld.md §7.5.)
