# name: test/sql/sharepoint.live.template
# description: Live round trip against a REAL Microsoft Graph tenant. NOT run
#              directly -- scripts/run_live_tests.sh materialises it into the
#              git-ignored test/sql/live/ with the run's real ids substituted
#              for the @...@ placeholders, then runs that copy. `make test_live`.
# group: [sharepoint]
#
# The placeholders below are the ONLY thing that ever differs between this
# committed template and the materialised copy -- no real credential is stored
# here. See docs/hld.md §7.5.

require sharepoint

require parquet

# Present in the materialised copy's environment (run_live_tests.sh exports
# them); a bare run without them skips rather than fails.
require-env SHAREPOINT_TENANT_ID

# DuckDB's runner skips any test whose error message contains "HTTP" or "Unable
# to connect" by default (an httpfs-flakiness convenience). For this merge gate
# that would turn a real Graph failure -- our errors read "HTTP <status>" -- into
# a false green. Replace the ignore list with a sentinel that never appears in a
# Graph error, so every failure here fails loudly. (The directive clears the
# defaults; it needs at least one token, hence the sentinel rather than empty.)
set ignore_error_messages __sharepoint_never_ignore__

statement ok
CREATE OR REPLACE SECRET sp_live (
    TYPE sharepoint,
    PROVIDER client_credentials,
    TENANT_ID '@SHAREPOINT_TENANT_ID@',
    CLIENT_ID '@SHAREPOINT_CLIENT_ID@',
    CLIENT_SECRET '@SHAREPOINT_CLIENT_SECRET@',
    DRIVE_ID '@SHAREPOINT_DRIVE_ID@'
);

# ---------------------------------------------------------------------------
# All fixtures live under one root so a run is self-contained and re-runnable
# (every write below replaces in place). Best-effort cleanup of the leaf files
# from a prior run first; remove_file returns false for an absent file, which is
# still `statement ok`.
# ---------------------------------------------------------------------------
statement ok
SELECT remove_file('sharepoint://_duckdb_sharepoint_live/hello.txt');

statement ok
SELECT remove_file('sharepoint://_duckdb_sharepoint_live/big.bin');

statement ok
SELECT remove_file('sharepoint://_duckdb_sharepoint_live/final.txt');

# Pre-create the folder chains. write_blob creates every missing parent
# directory (EnsureParentDirectories); a subsequent COPY into the folder then
# does not depend on Graph's implicit-parent behaviour.
statement ok
SELECT write_blob('sharepoint://_duckdb_sharepoint_live/data/.keep', ''::BLOB);

statement ok
SELECT write_blob('sharepoint://_duckdb_sharepoint_live/tree/sub/deep/.keep', ''::BLOB);

# ---------------------------------------------------------------------------
# 1. write_blob / read_blob / file_size round trip.
# ---------------------------------------------------------------------------
statement ok
SELECT write_blob('sharepoint://_duckdb_sharepoint_live/hello.txt', 'hello graph'::BLOB);

query I
SELECT file_size('sharepoint://_duckdb_sharepoint_live/hello.txt');
----
11

query I
SELECT content::VARCHAR FROM read_blob('sharepoint://_duckdb_sharepoint_live/hello.txt');
----
hello graph

# file_size of an absent file is NULL, not an error.
query I
SELECT file_size('sharepoint://_duckdb_sharepoint_live/nope.txt') IS NULL;
----
true

# ---------------------------------------------------------------------------
# 2. remove_file is idempotent: true when it existed, false the second time.
# ---------------------------------------------------------------------------
query I
SELECT remove_file('sharepoint://_duckdb_sharepoint_live/hello.txt');
----
true

query I
SELECT remove_file('sharepoint://_duckdb_sharepoint_live/hello.txt');
----
false

# ---------------------------------------------------------------------------
# 3. COPY ... TO (FORMAT parquet) then read_parquet -- the parquet path DuckLake
#    and read_parquet rely on.
# ---------------------------------------------------------------------------
statement ok
COPY (SELECT i AS id, i * 2 AS v FROM range(1000) t(i))
     TO 'sharepoint://_duckdb_sharepoint_live/data/nums.parquet' (FORMAT parquet);

query I
SELECT count(*) FROM read_parquet('sharepoint://_duckdb_sharepoint_live/data/nums.parquet');
----
1000

query I
SELECT sum(v) FROM read_parquet('sharepoint://_duckdb_sharepoint_live/data/nums.parquet');
----
999000

# ---------------------------------------------------------------------------
# 4. Resumable upload session (§7.2). Force the chunk size down to the 320-KiB
#    minimum and write ~900 KB, so the upload takes the multi-chunk session path
#    (3 chunks) rather than a single PUT.
# ---------------------------------------------------------------------------
statement ok
SET sharepoint_upload_chunk_bytes = 327680;

statement ok
CALL sharepoint_reset_stats();

statement ok
SELECT write_blob('sharepoint://_duckdb_sharepoint_live/big.bin', repeat('x', 900000)::BLOB);

# ONE Write() of 900000 bytes is still streamed: 2 full chunks as the buffer
# overflows, the 244640-byte rest as the final chunk, one commit.
query III
SELECT (SELECT value FROM sharepoint_stats() WHERE metric = 'upload_chunk'),
       (SELECT value FROM sharepoint_stats() WHERE metric = 'upload_commit'),
       (SELECT value FROM sharepoint_stats() WHERE metric = 'upload_buffer_peak');
----
3	1	327680

query I
SELECT file_size('sharepoint://_duckdb_sharepoint_live/big.bin');
----
900000

query I
SELECT octet_length(content) FROM read_blob('sharepoint://_duckdb_sharepoint_live/big.bin');
----
900000

statement ok
RESET sharepoint_upload_chunk_bytes;

# Read cache (§7.3): a small block size turns the 900 KB read into ~4 cached
# blocks, exercising the multi-block assembly path (not just a single block).
statement ok
SET sharepoint_block_size_bytes = 262144;

query I
SELECT octet_length(content) FROM read_blob('sharepoint://_duckdb_sharepoint_live/big.bin');
----
900000

statement ok
RESET sharepoint_block_size_bytes;

# ---------------------------------------------------------------------------
# 4b. Streaming writes. A write larger than one chunk does NOT buffer the file:
#     the handle opens a deferCommit upload session once its one-chunk buffer
#     overflows, sends each full chunk as it fills ("bytes a-b/*"), and the
#     final chunk + commit on close publish the file. Proven by the counters:
#     ONE session, ceil(size/chunk) chunk PUTs, ONE commit, no single PUT, and
#     a buffer high-water mark of exactly one chunk -- for a ~3.9 MB COPY.
#     Every chunk, the commit and any discard go to the session's uploadUrl,
#     which must pass the SharePoint host allow-list (IsAllowedUploadUrl) --
#     so this COPY also proves the live host shape is accepted.
# ---------------------------------------------------------------------------
statement ok
SET sharepoint_upload_chunk_bytes = 327680;

statement ok
SELECT remove_file('sharepoint://_duckdb_sharepoint_live/stream/s.csv');

statement ok
CALL sharepoint_reset_stats();

statement ok
COPY (SELECT i, md5(i::VARCHAR) AS h FROM range(100000) t(i))
     TO 'sharepoint://_duckdb_sharepoint_live/stream/s.csv' (HEADER);

query IIII
SELECT (SELECT value FROM sharepoint_stats() WHERE metric = 'upload_session'),
       (SELECT value FROM sharepoint_stats() WHERE metric = 'upload_commit'),
       (SELECT value FROM sharepoint_stats() WHERE metric = 'upload_put'),
       (SELECT value FROM sharepoint_stats() WHERE metric = 'upload_buffer_peak');
----
1	1	0	327680

# More than 3 chunks, and exactly one chunk PUT per 320 KiB (no retries here).
query II
SELECT file_size('sharepoint://_duckdb_sharepoint_live/stream/s.csv') > 3 * 327680,
       (SELECT value FROM sharepoint_stats() WHERE metric = 'upload_chunk')
           = ceil(file_size('sharepoint://_duckdb_sharepoint_live/stream/s.csv') / 327680.0);
----
true	true

# Byte-exact: the same COPY to a local file has the same md5.
statement ok
COPY (SELECT i, md5(i::VARCHAR) AS h FROM range(100000) t(i)) TO '__TEST_DIR__/stream_ref.csv' (HEADER);

query I
SELECT (SELECT md5(content) FROM read_blob('sharepoint://_duckdb_sharepoint_live/stream/s.csv'))
     = (SELECT md5(content) FROM read_blob('__TEST_DIR__/stream_ref.csv'));
----
true

query II
SELECT count(*), sum(i) FROM read_csv('sharepoint://_duckdb_sharepoint_live/stream/s.csv');
----
100000	4999950000

# Overwrite in place, streamed (write_blob has no tmp_ staging): the session
# replaces the existing item on commit.
statement ok
SELECT write_blob('sharepoint://_duckdb_sharepoint_live/stream/s.csv', repeat('y', 700000)::BLOB);

query II
SELECT octet_length(content), content[1:1] FROM read_blob('sharepoint://_duckdb_sharepoint_live/stream/s.csv');
----
700000	y

statement ok
COPY (SELECT i, md5(i::VARCHAR) AS h FROM range(100000) t(i))
     TO 'sharepoint://_duckdb_sharepoint_live/stream/s.csv' (HEADER);

# An error MID-STREAM (chunks already uploaded) publishes nothing: the session
# is discarded, so neither the target nor DuckDB's tmp_ staging file exists
# afterwards. One thread, so the rows before the error really are written (and
# chunked) before it is raised. ~16 MB before the error: DuckDB 2.0 writes COPY
# output through an AsyncFileWriter that buffers several MB, so fewer rows
# would fail before the first chunk and prove nothing. On 2.0 the discard
# arrives through FileSystem::AbortFileWrite, whose default is Close() -- i.e.
# COMMIT -- unless the filesystem overrides it.
statement ok
SET threads = 1;

statement ok
CALL sharepoint_reset_stats();

statement error
COPY (SELECT i, CASE WHEN i < 400000 THEN md5(i::VARCHAR) ELSE error('boom mid-stream') END AS h
      FROM range(410000) t(i))
     TO 'sharepoint://_duckdb_sharepoint_live/stream/fail.csv' (HEADER);
----
boom mid-stream

statement ok
RESET threads;

query IIII
SELECT (SELECT value >= 3 FROM sharepoint_stats() WHERE metric = 'upload_chunk'),
       (SELECT value FROM sharepoint_stats() WHERE metric = 'upload_abort'),
       (SELECT value FROM sharepoint_stats() WHERE metric = 'upload_commit'),
       (SELECT value FROM sharepoint_stats() WHERE metric = 'upload_buffer_peak');
----
true	1	0	327680

query I
SELECT count(*) FROM glob('sharepoint://_duckdb_sharepoint_live/stream/*fail*');
----
0

# Overwriting an existing file and failing mid-stream leaves the OLD content
# intact. DuckDB 1.x streams into a tmp_ staging file whose session is
# discarded, and the move onto the real name never happens. 2.0 writes remote
# targets in place (no staging file) and, as the target already existed, its
# cleanup PRESERVES whatever is there -- so only a discard that never commits
# keeps the original. A truncated overwrite is data loss.
statement ok
SET threads = 1;

statement ok
CALL sharepoint_reset_stats();

statement error
COPY (SELECT i, CASE WHEN i < 400000 THEN md5(i::VARCHAR) ELSE error('boom again') END AS h
      FROM range(410000) t(i))
     TO 'sharepoint://_duckdb_sharepoint_live/stream/s.csv' (HEADER);
----
boom again

statement ok
RESET threads;

query III
SELECT (SELECT value >= 3 FROM sharepoint_stats() WHERE metric = 'upload_chunk'),
       (SELECT value FROM sharepoint_stats() WHERE metric = 'upload_abort'),
       (SELECT value FROM sharepoint_stats() WHERE metric = 'upload_commit');
----
true	1	0

query I
SELECT count(*) FROM read_csv('sharepoint://_duckdb_sharepoint_live/stream/s.csv');
----
100000

query I
SELECT count(*) FROM glob('sharepoint://_duckdb_sharepoint_live/stream/*');
----
1

# Positional writes stay refused: a read-write ATTACH writes its database
# header at a byte offset. Refused loudly, and nothing is published.
statement error
ATTACH 'sharepoint://_duckdb_sharepoint_live/stream/rw.duckdb' AS sp_rw;
----
byte offset

query I
SELECT count(*) FROM glob('sharepoint://_duckdb_sharepoint_live/stream/rw*');
----
0

statement ok
SELECT remove_file('sharepoint://_duckdb_sharepoint_live/stream/s.csv');

statement ok
RESET sharepoint_upload_chunk_bytes;

# ---------------------------------------------------------------------------
# 5. Recursive ** glob across folders (§7.4). Three parquet files at three
#    depths; `**/*.parquet` finds all of them and read_parquet unions them.
# ---------------------------------------------------------------------------
statement ok
COPY (SELECT 1 AS a) TO 'sharepoint://_duckdb_sharepoint_live/tree/x.parquet' (FORMAT parquet);

statement ok
COPY (SELECT 2 AS a) TO 'sharepoint://_duckdb_sharepoint_live/tree/sub/y.parquet' (FORMAT parquet);

statement ok
COPY (SELECT 3 AS a) TO 'sharepoint://_duckdb_sharepoint_live/tree/sub/deep/z.parquet' (FORMAT parquet);

query I
SELECT count(*) FROM glob('sharepoint://_duckdb_sharepoint_live/tree/**/*.parquet');
----
3

query I
SELECT sum(a) FROM read_parquet('sharepoint://_duckdb_sharepoint_live/tree/**/*.parquet');
----
6

# A single * is one level only: just tree/x.parquet.
query I
SELECT count(*) FROM glob('sharepoint://_duckdb_sharepoint_live/tree/*.parquet');
----
1

# Character classes and {a,b} alternation -- the same pattern syntax as the
# sibling gdrive. An alternative may span folders.
query I
SELECT count(*) FROM glob('sharepoint://_duckdb_sharepoint_live/tree/**/[xyz].parquet');
----
3

query I
SELECT count(*) FROM glob('sharepoint://_duckdb_sharepoint_live/tree/**/[!x].parquet');
----
2

query I
SELECT count(*) FROM glob('sharepoint://_duckdb_sharepoint_live/tree/{x,nothere}.parquet');
----
1

query I
SELECT sum(a) FROM read_parquet('sharepoint://_duckdb_sharepoint_live/tree/{sub/y,sub/deep/z}.parquet');
----
5

# Cross-check with gdrive (same scenario script on both backends): glob yields
# FILES only -- a literal folder path is no match -- and reading an absent
# file is DuckDB's "No files found", not a Graph error from the literal
# fallback stat-ing core's synthesized "<path>/**/*.csv" probe.
query I
SELECT count(*) FROM glob('sharepoint://_duckdb_sharepoint_live/tree');
----
0

statement error
SELECT * FROM read_csv('sharepoint://_duckdb_sharepoint_live/tree/absent.csv');
----
No files found

# ---------------------------------------------------------------------------
# 6. move_file: write a staging file, publish it under its final name.
# ---------------------------------------------------------------------------
statement ok
SELECT write_blob('sharepoint://_duckdb_sharepoint_live/staging.tmp', 'movable'::BLOB);

query I
SELECT move_file('sharepoint://_duckdb_sharepoint_live/staging.tmp',
                 'sharepoint://_duckdb_sharepoint_live/final.txt');
----
true

query I
SELECT content::VARCHAR FROM read_blob('sharepoint://_duckdb_sharepoint_live/final.txt');
----
movable

# The source no longer exists after the move.
query I
SELECT file_size('sharepoint://_duckdb_sharepoint_live/staging.tmp') IS NULL;
----
true

# ---------------------------------------------------------------------------
# 7. COPY re-run onto an existing file. DuckDB writes a tmp_ file and MOVES it
#    onto the final name; without conflictBehavior=replace the second run is a
#    409 (crew finding F8). Section 3 already wrote nums.parquet once.
# ---------------------------------------------------------------------------
statement ok
COPY (SELECT 42 AS id, 0 AS v) TO 'sharepoint://_duckdb_sharepoint_live/data/nums.parquet' (FORMAT parquet);

query I
SELECT sum(id) FROM read_parquet('sharepoint://_duckdb_sharepoint_live/data/nums.parquet');
----
42

# ---------------------------------------------------------------------------
# 8. Hostile names. Names used to be concatenated into the move /
#    create-folder JSON bodies unescaped (crew finding F6). SharePoint itself
#    forbids " * : < > ? / \ | in names, so the legal hostile set is
#    ' # % + & ; { } spaces and non-ASCII -- which also exercises path encoding.
# ---------------------------------------------------------------------------
statement ok
SELECT write_blob('sharepoint://_duckdb_sharepoint_live/odd/staging.tmp', 'odd'::BLOB);

query I
SELECT move_file('sharepoint://_duckdb_sharepoint_live/odd/staging.tmp',
                 'sharepoint://_duckdb_sharepoint_live/odd/it''s #1 %41+b & ünï;{x}.txt');
----
true

# '{x}' is also glob alternation; a pattern that matches nothing falls back to
# the literal name, as DuckDB's local filesystem does.
query I
SELECT content::VARCHAR FROM read_blob('sharepoint://_duckdb_sharepoint_live/odd/it''s #1 %41+b & ünï;{x}.txt');
----
odd

# A name SharePoint forbids is refused up front with a message that says so
# (it used to reach Graph: '"' came back as a bare 400, and ':' -- Graph's own
# root:/path: delimiter -- as "Resource not found for the segment 'root:'").
statement ok
SELECT write_blob('sharepoint://_duckdb_sharepoint_live/odd/staging2.tmp', 'odd'::BLOB);

statement error
SELECT move_file('sharepoint://_duckdb_sharepoint_live/odd/staging2.tmp',
                 'sharepoint://_duckdb_sharepoint_live/odd/q"uote.txt');
----
SharePoint does not allow '"'

statement error
SELECT write_blob('sharepoint://_duckdb_sharepoint_live/odd/colon:name.txt', 'x'::BLOB);
----
SharePoint does not allow ':'

statement ok
SELECT remove_file('sharepoint://_duckdb_sharepoint_live/odd/staging2.tmp');

# A folder with a hostile name, created implicitly by write_blob.
statement ok
SELECT write_blob('sharepoint://_duckdb_sharepoint_live/odd/f''ol #der/x.txt', 'x'::BLOB);

query I
SELECT file_size('sharepoint://_duckdb_sharepoint_live/odd/f''ol #der/x.txt');
----
1

# ---------------------------------------------------------------------------
# 9. Permanent delete uses Graph's permanentDelete action (the old
#    `Prefer: permanent-delete` header was silently ignored -> recycle bin).
# ---------------------------------------------------------------------------
statement ok
SET sharepoint_permanent_delete = true;

query I
SELECT remove_file('sharepoint://_duckdb_sharepoint_live/odd/f''ol #der/x.txt');
----
true

query I
SELECT file_size('sharepoint://_duckdb_sharepoint_live/odd/f''ol #der/x.txt') IS NULL;
----
true

statement ok
RESET sharepoint_permanent_delete;

statement ok
SELECT remove_file('sharepoint://_duckdb_sharepoint_live/odd/it''s #1 %41+b & ünï;{x}.txt');

# ---------------------------------------------------------------------------
# 10. Token cache identity (crew finding F5). The cache used to be keyed by
#     the secret's NAME: recreating `sp_live` with a wrong client secret was
#     still served the token minted for the right one. Keyed by a fingerprint
#     of the credentials, the wrong secret must authenticate on its own -- and
#     fail.
# ---------------------------------------------------------------------------
statement ok
CREATE OR REPLACE SECRET sp_live (
    TYPE sharepoint,
    PROVIDER client_credentials,
    TENANT_ID '@SHAREPOINT_TENANT_ID@',
    CLIENT_ID '@SHAREPOINT_CLIENT_ID@',
    CLIENT_SECRET 'definitely-not-the-secret',
    DRIVE_ID '@SHAREPOINT_DRIVE_ID@'
);

statement error
SELECT file_size('sharepoint://_duckdb_sharepoint_live/data/nums.parquet');
----
invalid_client

statement ok
CREATE OR REPLACE SECRET sp_live (
    TYPE sharepoint,
    PROVIDER client_credentials,
    TENANT_ID '@SHAREPOINT_TENANT_ID@',
    CLIENT_ID '@SHAREPOINT_CLIENT_ID@',
    CLIENT_SECRET '@SHAREPOINT_CLIENT_SECRET@',
    DRIVE_ID '@SHAREPOINT_DRIVE_ID@'
);

# ---------------------------------------------------------------------------
# 11. sharepoint_stats() and sharepoint_immutable_prefixes. A read costs a stat
#     for the glob and one for the open; under a declared-immutable prefix the
#     open's stat is served from the metadata cache. Our own rewrite
#     invalidates it, so the new content is read.
# ---------------------------------------------------------------------------
statement ok
SELECT write_blob('sharepoint://_duckdb_sharepoint_live/imm/a.txt', 'abc'::BLOB);

statement ok
SET sharepoint_immutable_prefixes = 'sharepoint://_duckdb_sharepoint_live/imm';

# First read under the prefix: both stats go to Graph, and fill the cache.
statement ok
SELECT content FROM read_blob('sharepoint://_duckdb_sharepoint_live/imm/a.txt');

statement ok
CALL sharepoint_reset_stats();

query T
SELECT content::VARCHAR FROM read_blob('sharepoint://_duckdb_sharepoint_live/imm/a.txt');
----
abc

query II
SELECT (SELECT value FROM sharepoint_stats() WHERE metric = 'stat'),
       (SELECT value FROM sharepoint_stats() WHERE metric = 'meta_cache_hits');
----
1	1

statement ok
SELECT write_blob('sharepoint://_duckdb_sharepoint_live/imm/a.txt', 'abcdef'::BLOB);

query I
SELECT octet_length(content) FROM read_blob('sharepoint://_duckdb_sharepoint_live/imm/a.txt');
----
6

# file_size opens first: one stat for a present file (it used to ask
# FileExists, then open -- two; three for an absent file).
statement ok
CALL sharepoint_reset_stats();

statement ok
SELECT file_size('sharepoint://_duckdb_sharepoint_live/data/nums.parquet');

query I
SELECT value FROM sharepoint_stats() WHERE metric = 'stat';
----
1

statement ok
RESET sharepoint_immutable_prefixes;

statement ok
SELECT remove_file('sharepoint://_duckdb_sharepoint_live/imm/a.txt');

# ---------------------------------------------------------------------------
# 12. Folders are not files, and not absent (crew finding F10): an existing
#     folder used to make remove_file return false and file_size NULL.
# ---------------------------------------------------------------------------
statement error
SELECT remove_file('sharepoint://_duckdb_sharepoint_live/tree');
----
is a directory

statement error
SELECT file_size('sharepoint://_duckdb_sharepoint_live/tree');
----
is a directory

# ---------------------------------------------------------------------------
# 13. ATTACH a DuckDB database file stored on SharePoint, read-only. Found by
#     exploratory testing: DuckDB 1.5 canonicalized the path to
#     "sharepoint:/..." ("database does not exist"), and then opened the file
#     with a database-level opener that has no client connection, which the
#     secret lookup required.
# ---------------------------------------------------------------------------
statement ok
ATTACH '__TEST_DIR__/sp_attach.duckdb' AS loc;

statement ok
CREATE TABLE loc.t AS SELECT i, 'row ' || i AS s FROM range(100000) t(i);

statement ok
DETACH loc;

statement ok
SELECT write_blob('sharepoint://_duckdb_sharepoint_live/attach/db.duckdb', content)
FROM read_blob('__TEST_DIR__/sp_attach.duckdb');

statement ok
ATTACH 'sharepoint://_duckdb_sharepoint_live/attach/db.duckdb' AS remote (READ_ONLY);

query II
SELECT count(*), sum(i) FROM remote.t;
----
100000	4999950000

# 14. A handle outlives its token (crew round 3, F1): handles hold a token
#     SOURCE, not a token, and re-mint before expiry. Cap the token lifetime
#     to 61 s (stale after 1 s given the 60 s refresh margin), keep the ATTACH
#     open past it, and read again: a new token is minted, the read succeeds.
statement ok
DETACH remote;

statement ok
SET GLOBAL sharepoint_debug_token_max_age_seconds = 61;

# A fresh copy, with the block cache off (the handle captures the size at
# open): section 13's reads of db.duckdb are cached -- by our block cache and
# by DuckDB itself -- and would be served without any request, so without
# ever needing a token.
statement ok
SELECT write_blob('sharepoint://_duckdb_sharepoint_live/attach/db2.duckdb', content)
FROM read_blob('__TEST_DIR__/sp_attach.duckdb');

# Session AND global: section 4's SET/RESET left a session-level value, which
# shadows a global one.
statement ok
SET sharepoint_block_size_bytes = 0;

statement ok
SET GLOBAL sharepoint_block_size_bytes = 0;

statement ok
ATTACH 'sharepoint://_duckdb_sharepoint_live/attach/db2.duckdb' AS remote (READ_ONLY);

statement ok
CALL sharepoint_reset_stats();

# ATTACH read only the header/metadata; the column data is first read after
# the token went stale.
sleep 3 seconds

query I
SELECT sum(i) FROM remote.t;
----
4999950000

query II
SELECT (SELECT value >= 1 FROM sharepoint_stats() WHERE metric = 'token_request'),
       (SELECT value >= 1 FROM sharepoint_stats() WHERE metric = 'read_range');
----
true	true

statement ok
DETACH remote;

statement ok
RESET GLOBAL sharepoint_debug_token_max_age_seconds;

statement ok
RESET GLOBAL sharepoint_block_size_bytes;

statement ok
RESET sharepoint_block_size_bytes;

# ---------------------------------------------------------------------------
# 15. A 401 is answered by ONE fresh token and one re-send -- and when that
#     cannot help (a pasted, garbage ACCESS_TOKEN has nothing to refresh
#     with), the failure is a clean authentication error, not a loop.
# ---------------------------------------------------------------------------
statement ok
CREATE SECRET sp_bogus (TYPE sharepoint, PROVIDER config, ACCESS_TOKEN 'not-a-token',
    DRIVE_ID '@SHAREPOINT_DRIVE_ID@', SCOPE 'sharepoint://_duckdb_sharepoint_live/bogus');

statement ok
CALL sharepoint_reset_stats();

statement error
SELECT file_size('sharepoint://_duckdb_sharepoint_live/bogus/x.txt');
----
unauthenticated

query I
SELECT value FROM sharepoint_stats() WHERE metric = 'auth_refresh';
----
1

statement ok
DROP SECRET sp_bogus;

# ---------------------------------------------------------------------------
# PROVIDER device_code against the REAL Entra ID endpoints. Nobody is there to
# sign in, so this proves everything up to the human: the /devicecode request
# (public client, raw TLS transport), parsing its reply, printing the prompt,
# and RFC 8628 polling (authorization_pending is kept polling) -- then the
# bounded wait gives up with a teaching error. The app-only app registration
# answers /devicecode too (verified 2026-10-14), so no delegated app is needed.
# ---------------------------------------------------------------------------
# 12 s against Entra's 5 s interval: room for a slow /devicecode reply and
# still at least one poll (asserted loosely below, so timing cannot flake it).
statement ok
SET sharepoint_device_code_timeout_seconds = 12;

statement ok
CREATE SECRET sp_devicecode (TYPE sharepoint, PROVIDER device_code, TENANT_ID '@SHAREPOINT_TENANT_ID@',
    CLIENT_ID '@SHAREPOINT_CLIENT_ID@', DRIVE_ID '@SHAREPOINT_DRIVE_ID@',
    SCOPE 'sharepoint://_duckdb_sharepoint_live/devicecode');

statement ok
CALL sharepoint_reset_stats();

statement error
SELECT file_size('sharepoint://_duckdb_sharepoint_live/devicecode/x.txt');
----
the device-code sign-in was not completed within 12 seconds

# At least the /devicecode request reached the token host.
query I
SELECT value >= 1 FROM sharepoint_stats() WHERE metric = 'token_request';
----
true

statement ok
DROP SECRET sp_devicecode;

# The delegated refresh path (public client: no CLIENT_SECRET is sent) against
# the real token endpoint: a rejected refresh token gets the delegated fix --
