# name: test/sql/changes_offline.test
# description: sharepoint_changes (#62) without a tenant: registered, and bad
#              input fails before any Graph call. The delta itself is
#              e2e/tests/test_changes.py.
# group: [sharepoint]

require sharepoint

query I
SELECT count(*) FROM duckdb_functions() WHERE function_name = 'sharepoint_changes' AND function_type = 'table';
----
1

statement error
SELECT * FROM sharepoint_changes(NULL);
----
must not be NULL

statement error
SELECT * FROM sharepoint_changes('sharepoint://id:01ABC');
----
takes a folder path

statement error
SELECT * FROM sharepoint_changes('sharepoint://x', token := 'a/b?c');
----
not a token sharepoint_changes returned

# sharepoint_permissions (#98): registered; a path is checked before any secret.
query I
SELECT count(*) FROM duckdb_functions() WHERE function_name = 'sharepoint_permissions';
----
1

statement error
SELECT * FROM sharepoint_permissions(NULL);
----
must not be NULL

statement error
SELECT * FROM sharepoint_permissions('sharepoint://Finance/x.csv');
----
no `sharepoint` secret configured
