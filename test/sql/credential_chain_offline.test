# name: test/sql/credential_chain_offline.test
# description: PROVIDER credential_chain (#72) without Azure: the secret needs
#              a drive, holds no credential, and a read where no source has an
#              identity names each source and why.
# group: [sharepoint]

require sharepoint

statement error
CREATE SECRET c (TYPE sharepoint, PROVIDER credential_chain);
----
needs DRIVE_ID or SITE_ID

statement ok
CREATE SECRET c (TYPE sharepoint, PROVIDER credential_chain, DRIVE_ID 'b!x');
