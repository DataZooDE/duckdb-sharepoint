# name: test/sql/sharepoint_vfs_no_secret.test
# description: a missing secret is a CONFIGURATION error, never "no such file"
# group: [sharepoint]
#
# No credentials needed, deliberately: the whole point is that these calls must
# fail before any network access.
#
# Ported from the sibling gdrive (gdrive_vfs_no_secret.test), whose drill
# found file_size returning NULL and remove_file returning false for an
# UNCONFIGURED extension -- reporting a configuration error as a missing file.
# FileSystem::FileExists must answer false when no secret exists (DuckDB core
# probes speculatively during binding), so the user-facing functions confirm
# absence with an explicit NULL_IF_NOT_EXISTS open, which raises the real error.

require sharepoint

statement error
SELECT file_size('sharepoint://anything/at/all.parquet');
----
secret configured for

statement error
SELECT remove_file('sharepoint://anything/at/all.parquet');
----
secret configured for

statement error
SELECT write_blob('sharepoint://anything/at/all.parquet', 'x'::BLOB);
----
secret configured for

statement error
SELECT move_file('sharepoint://a/b.txt', 'sharepoint://a/c.txt');
----
secret configured for

# glob has always been loud about this (REQ-F-08 / R-2). Pinned here so the
# four functions above stay consistent with it.
statement error
SELECT * FROM glob('sharepoint://anything/*.parquet');
----
secret configured for
