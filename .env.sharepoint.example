# Copy to .env.sharepoint (git-ignored) for `make test_live` / `make e2e`.
# An Entra ID app registration with admin-consented APPLICATION permission
# Sites.ReadWrite.All (or Files.ReadWrite.All), and a document library it may write to.
SHAREPOINT_TENANT_ID=00000000-0000-0000-0000-000000000000
SHAREPOINT_CLIENT_ID=00000000-0000-0000-0000-000000000000
SHAREPOINT_CLIENT_SECRET=
SHAREPOINT_DRIVE_ID=b!...
# Optional: a site whose DEFAULT library is a different drive (e2e scoping test).
SHAREPOINT_SITE_ID=
